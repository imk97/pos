        <item name="windowSplashScreenBackground">@color/black</item>

        <!-- Icon / logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/rc_launcher_background</item>

        <!-- Lepas splash, pergi ke theme app -->
        <item name="postSplashScreenTheme">@style/Base.Theme.PointOfSalesMobile</item>
    </style>
</resources>